    producto = buscar_producto(dato)
    if producto:
        cantidad_entrada = int(input("Cantidad de entrada: "))
        producto['cantidad'] += cantidad_entrada
        fecha = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        movimientos.append({
